# ------------------------------------------------------------------
# SAWEE CARS — environment template
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# NEVER commit the real .env file or real secrets to version control.
# On Vercel, set these values in: Project Settings > Environment Variables.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# REQUIRED — Database (Neon PostgreSQL)
# ------------------------------------------------------------------
# The app uses Neon PostgreSQL (serverless Postgres).
# Local development and production can share the same Neon database.
#
# Use the POOLED connection string (host contains "-pooler.") for the
# app runtime, with pgbouncer mode enabled:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=10"

# ------------------------------------------------------------------
# REQUIRED IN PRODUCTION — Session secret
# ------------------------------------------------------------------
# Signs the admin session JWTs (HS256). Must be at least 32 characters.
# Generate one with:  openssl rand -hex 32
#
# - Development: if unset, a built-in DEV-ONLY fallback secret is used so
#   the app boots with zero setup. Never rely on it outside development.
# - Production: the app THROWS at startup if AUTH_SECRET is missing or
#   shorter than 32 characters.
AUTH_SECRET="replace-me-with-openssl-rand-hex-32-chars-minimum"

# ------------------------------------------------------------------
# REQUIRED IN PRODUCTION — Canonical site URL
# ------------------------------------------------------------------
# Public origin of the site (no trailing slash). Used for:
#   sitemap.xml, robots.txt (sitemap reference), canonical URLs,
#   Open Graph / Twitter metadata, and the links inside pre-filled
#   WhatsApp enquiry messages.
# Defaults to http://localhost:3000 when unset.
# On Vercel, set this to your deployment URL, e.g. https://saweecars.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------
# OPTIONAL — Cloudinary image storage (STRONGLY RECOMMENDED on Vercel)
# ------------------------------------------------------------------
# When ALL THREE credentials below are set, vehicle photos are uploaded
# server-side to Cloudinary using signed uploads (the API secret never
# reaches the browser). When any of them is missing, the app falls back
# to LOCAL disk storage automatically.
#
# IMPORTANT: on serverless hosts (Vercel) the filesystem is EPHEMERAL —
# files written locally disappear between invocations. You MUST
# configure Cloudinary on Vercel or uploaded images will be lost.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Optional — folder that receives vehicle images on Cloudinary.
# Defaults to "saweecars/vehicles".
CLOUDINARY_FOLDER="saweecars/vehicles"

# ------------------------------------------------------------------
# OPTIONAL — Local storage driver override (development only)
# ------------------------------------------------------------------
# Directory used by the local fallback driver. Defaults to
# <project-root>/uploads. Files are written under vehicles/ inside this
# directory and served through /api/files/....
# UPLOAD_DIR="/home/z/my-project/uploads"
