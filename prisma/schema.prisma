// ============================================================
// Sawee Vintage & Classic Cars — Database Schema
// ------------------------------------------------------------
// DEVELOPMENT NOTE:
//   This schema runs on SQLite for local development.
//   It is designed to be 100% portable to MySQL for production.
//
//   To switch to MySQL in production:
//     1. Change datasource provider to "mysql"
//     2. Set DATABASE_URL to the MySQL connection string
//     3. On Vehicle.price, restore the native type:
//          price Decimal @db.Decimal(14, 2)
//        (native type attributes are not supported on SQLite)
//     4. Run: npx prisma migrate deploy
//
// Design rules used for portability:
//   - Role / status / condition fields are String columns
//     (SQLite does not support Prisma enums). Values are
//     strictly validated server-side with Zod.
//   - All relations use explicit foreign keys with defined
//     cascade behaviour.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// Admin users — no public registration.
// Roles: SUPER_ADMIN | ADMIN | EDITOR (validated server-side)
// ------------------------------------------------------------
model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         String     @default("EDITOR") // SUPER_ADMIN | ADMIN | EDITOR
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

// ------------------------------------------------------------
// Vehicle master data
// ------------------------------------------------------------
model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  vehicles Vehicle[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  vehicles    Vehicle[]
}

// ------------------------------------------------------------
// Vehicle inventory
// status: AVAILABLE | RESERVED | SOLD
// ------------------------------------------------------------
model Vehicle {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  brandId        String
  model          String
  categoryId     String?
  year           Int
  price          Decimal // MySQL: Decimal @db.Decimal(14, 2)
  currency       String         @default("TZS")
  mileage        Int? // kilometers
  fuelType       String? // Petrol | Diesel | Hybrid | Electric
  transmission   String? // Manual | Automatic
  engineCapacity String? // e.g. "2.8 L", "2800 cc"
  condition      String? // RESTORED | EXCELLENT | GOOD | FAIR | PROJECT
  description    String
  highlights     String? // newline-separated list
  status         String         @default("AVAILABLE") // AVAILABLE | RESERVED | SOLD
  isFeatured     Boolean        @default(false)
  isPublished    Boolean        @default(false)
  viewCount      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  brand    Brand          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images   VehicleImage[]

  @@index([slug])
  @@index([isPublished, status])
  @@index([isPublished, isFeatured])
  @@index([isPublished, createdAt])
  @@index([brandId])
  @@index([categoryId])
  @@index([year])
  @@index([price])
}

model VehicleImage {
  id        String  @id @default(cuid())
  vehicleId String
  imageUrl  String
  publicId  String? // Cloudinary public id — null for local fallback storage
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, sortOrder])
}

// ------------------------------------------------------------
// Singleton row ("singleton") holding all configurable
// business information used across the website.
// ------------------------------------------------------------
model SiteSetting {
  id              String   @id @default("singleton")
  businessName    String   @default("Sawee Vintage & Classic Cars")
  phone           String   @default("+255710853255")
  whatsappNumber  String   @default("255710853255")
  instagramUrl    String   @default("https://www.instagram.com/sawee_oldcarstz/")
  address         String? // intentionally blank until client approves a location
  businessHours   String?
  logoUrl         String?
  metaTitle       String?
  metaDescription String?
  footerNote      String?
  heroImageUrl    String?
  aboutIntro      String?
  aboutStory      String?
  aboutMission    String?
  aboutVision     String?
  aboutCommitment String?
  updatedAt       DateTime @updatedAt
}

// ------------------------------------------------------------
// Security audit trail
// ------------------------------------------------------------
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String?
  action     String // LOGIN, LOGIN_FAILED, VEHICLE_CREATE, ...
  entityType String // AUTH | VEHICLE | IMAGE | SETTINGS | USER
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId])
}

// ------------------------------------------------------------
// Retryable Cloudinary cleanup queue.
// When an asset deletion fails (network/API error) it is
// queued here and retried from Admin > Media.
// ------------------------------------------------------------
model PendingMediaDeletion {
  id        String   @id @default(cuid())
  publicId  String   @unique
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
}
